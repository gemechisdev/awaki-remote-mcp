# GitHub classic PAT: repo + delete_repo scopes. Keep secret.
GITHUB_TOKEN=github_pat_or_classic_token
# Long random secret; send as Authorization: Bearer <token> to MCP and /upload.
MCP_API_TOKEN=replace-with-a-long-random-secret
# Telegram bot token and channel ID (bot must be channel admin with post permission).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel
# Optional limits
MAX_UPLOAD_MB=100
MAX_EXTRACT_MB=500
MAX_BUILD_MINUTES=45
GITHUB_REPO_PREFIX=agent-build
TEMP_DIR=/tmp/remote-build-mcp
