# ---- required -------------------------------------------------------------
# Random secret the AI agent uses to call this service (>= 24 chars):  openssl rand -hex 32
MCP_API_TOKEN=
# Fine-grained PAT limited to ONE repo (the public runner repo). See README step 2.
GITHUB_TOKEN=
# Your public runner repo, owner/name
GITHUB_REPO=
# Public https URL of this service (auto-detected on Render and Koyeb)
PUBLIC_URL=

# ---- optional -------------------------------------------------------------
GITHUB_REF_NAME=main
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_ARTIFACT_MB=200
ARTIFACT_TTL_MINUTES=180
MAX_BUILD_MINUTES=60
MAX_CONCURRENT_BUILDS=3
JOB_RETENTION_HOURS=72
SYNC_RUNNER_REPO=true
# RUNNER_TOKEN=   (derived from MCP_API_TOKEN when empty; leave empty)
